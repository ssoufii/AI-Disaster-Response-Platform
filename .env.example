# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_CONCURRENCY=10

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
ASL_CLIP_BASE_URL=        # public base URL for the ASL interpreter clips Twilio fetches

DATABASE_URL=postgresql+asyncpg://localhost/disaster_response
PUBLIC_BASE_URL=          # ngrok URL in dev; required for Twilio callbacks
CONSOLE_ORIGINS=http://localhost:3000   # comma-separated; the console's browser-side resync reads from here

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
